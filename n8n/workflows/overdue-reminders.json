        "jsCode": "const response = $input.first().json; const rows = response.loans || []; return rows.map(row => { const day = new Date().toISOString().slice(0,10); const reminderKey = 'overdue:' + row.loanId + ':' + day; return {json:{loanId:row.loanId, reminderKey, borrowerRef:row.borrowerRef, item:row.item, endDate:row.endDate}}; });",
        "mode": "runOnceForAllItems",
        "language": "javaScript"
      },
