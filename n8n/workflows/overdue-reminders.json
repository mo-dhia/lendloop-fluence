      "typeVersion": 2,
      "position": [960, 320]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfunction canonical(v) { if (Array.isArray(v)) return '[' + v.map(canonical).join(',') + ']'; if (v && typeof v === 'object') return '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + canonical(v[k])).join(',') + '}'; return JSON.stringify(v); }\nreturn $input.all().map(item => { const payload={loanId:item.json.loanId,reminderKey:item.json.reminderKey}; const timestamp=String(Math.floor(Date.now()/1000)); const nonce=crypto.randomUUID(); const path='/lendloop/automation/reminder'; const signed='POST\\n'+path+'\\n'+timestamp+'\\n'+nonce+'\\n'+canonical(payload); const signature=crypto.createHmac('sha256',$env.INTEGRATION_HMAC_SECRET).update(signed).digest('hex'); return {json:{url:$env.CONVEX_HTTP_URL+path,payload,headers:{'content-type':'application/json','x-lendloop-timestamp':timestamp,'x-lendloop-nonce':nonce,'x-lendloop-signature':signature},mock:{kind:'overdue-reminder',recipientRef:item.json.borrowerRef,item:item.json.item,endDate:item.json.endDate,delivery:'logged-mock'}}}; });",
        "mode": "runOnceForAllItems",
        "language": "javaScript"
