# Clerk (required for interactive sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Convex deployment URL generated by `bunx convex dev`
NEXT_PUBLIC_CONVEX_URL=

# Set on Convex deployment environment (not NEXT_PUBLIC):
# ADMIN_CLERK_IDS=clerk_user_id_1,clerk_user_id_2
# INTEGRATION_HMAC_SECRET=generate-at-least-32-random-bytes
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-events
# APP_BASE_URL=http://localhost:4100
# N8N_HTTP_BASE_URL=http://localhost:5678

# n8n docker-compose values (put in local .env; never commit)
N8N_ENCRYPTION_KEY=
CONVEX_HTTP_URL=http://host.docker.internal:3211
INTEGRATION_HMAC_SECRET=
N8N_PORT=5678
